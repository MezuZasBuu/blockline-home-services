# Server-only values. Never prefix privileged keys with NEXT_PUBLIC_.
# Copy to .env.local (or use .env.staging.local for the linked Supabase project).
# Dashboard → Project Settings → API: URL, publishable key, and secret key (sb_secret_ → SUPABASE_SERVICE_ROLE_KEY).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Session Pooler URL for `pnpm db:migration:list` and `pnpm db:push:dry-run` only.
SUPABASE_DB_URL=
APP_ORIGIN=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
