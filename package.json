{
  "name": "blockline-home-services",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "pnpm test && pnpm typecheck && pnpm lint",
    "db:verify": "node scripts/verify-supabase.mjs",
    "db:migration:list": "node scripts/supabase-db.mjs migration list",
    "db:push:dry-run": "node scripts/supabase-db.mjs db push --dry-run --skip-vault"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "stripe": "^18.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.10",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
